# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง (ไฟล์ .env จะไม่ถูก commit)
# สร้าง key ฟรีที่ https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
JWT_SECRET=change-me-to-a-long-random-string

# Google Sign-In (OAuth client ประเภท "Web application" จาก Google Cloud Console)
GOOGLE_CLIENT_ID=
ALLOWED_EMAIL_DOMAIN=kmitl.ac.th
# ALLOW_PASSWORD_REGISTER=true   # เปิดให้สมัครด้วยรหัสผ่านได้ (ปกติปิด)

# ฐานข้อมูล Turso (ไม่ใส่ = ใช้ไฟล์ data/foodcourt.db ในเครื่อง)
# TURSO_DATABASE_URL=libsql://foodcourt-siet-<ชื่อบัญชี>.turso.io
# TURSO_AUTH_TOKEN=
