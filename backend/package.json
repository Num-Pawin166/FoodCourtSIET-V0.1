  "main": "index.js",
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "seed": "node --env-file-if-exists=.env src/seed.js",
    "test:coverage": "node --test --experimental-test-coverage \"--test-coverage-include=src/**/*.js\" --test-coverage-exclude=src/server.js --test-coverage-lines=70 --test-coverage-branches=70 --test-coverage-functions=70 --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info \"test/*.test.js\""
  },
