flowchart LR
    subgraph P1["① เลือกและสั่งอาหาร"]
        direction TB
        A([นักศึกษาเปิดแอป]) --> B{ล็อกอินอยู่แล้ว?}
        B -- ไม่ --> C[ล็อกอิน Google<br/>@kmitl.ac.th] --> D
        B -- ใช่ --> D[หน้าแรก<br/>ร้าน คิว เวลารอ]
        D --> E{เลือกเอง<br/>หรือให้ AI ช่วย?}
        E -- AI --> AI[AI แนะนำเมนูจริง<br/>ตามงบ/ความชอบ] --> F
        E -- เลือกเอง --> F[เปิดหน้าร้าน<br/>ใส่ตะกร้า → SQLite]
        F --> H[เลือกเวลารับ<br/>หมายเหตุ วิธีจ่าย]
        H --> J[ยืนยัน → เซิร์ฟเวอร์คิดราคา<br/>ออกเลขคิว A-001 → Turso]
    end

    subgraph P2["② จ่ายเงินและร้านทำอาหาร"]
        direction TB
        K{จ่ายแบบไหน?}
        K -- พร้อมเพย์ --> P[สแกน QR โอน<br/>แนบสลิป] --> Q
        K -- จ่ายที่ร้าน --> Q[แอปร้านค้าเจอออเดอร์ใหม่<br/>🔔 เสียงเตือนซ้ำ]
        Q --> R{ร้านรับ?}
        R -- ปฏิเสธ --> X([ยกเลิก<br/>แจ้งเหตุผลลูกค้า])
        R -- รับ --> S[กำลังทำ → พร้อมรับ]
    end

    subgraph P3["③ รับอาหารและรีวิว"]
        direction TB
        T[นักศึกษาเห็นสถานะ<br/>พร้อมรับ] --> U[แสดงเลขคิวที่ร้าน<br/>ร้านกด ลูกค้ารับแล้ว]
        U --> W[ให้คะแนนร้าน<br/>บันทึกลง Firestore]
        W --> Y([ทุกคนเห็นในหน้าร้าน<br/>ร้านเห็นในแท็บ รีวิว])
    end

    P1 ==> P2 ==> P3
